{
  "buildCommand": "npm run build:seo",
  "redirects": [
    {
      "source": "/services/document_registration",
      "destination": "/services/document-registration",
      "statusCode": 301
    },
    {
      "source": "/services/marriage_registration",
      "destination": "/services/marriage-registration",
      "statusCode": 301
    },
    {
      "source": "/services/encumbrance_certificate",
      "destination": "/services/encumbrance-certificate",
      "statusCode": 301
    },
    {
      "source": "/services/document_copy",
      "destination": "/services/document-copy",
      "statusCode": 301
    },
    {
      "source": "/services/birth_death_certificate",
      "destination": "/services/birth-death-certificate",
      "statusCode": 301
    },
    {
      "source": "/services/patta_chitta",
      "destination": "/services/patta-chitta",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icon.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/background.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
